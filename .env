# ==========================================
# Application
# ==========================================
APP__APP_NAME=SecGenie AI
APP__APP_VERSION=0.1.0
APP__ENVIRONMENT=development
APP__DEBUG=true


# ==========================================
# Database
# ==========================================
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__USERNAME=postgres
DATABASE__PASSWORD=
DATABASE__DATABASE=secgenie

DATABASE__ECHO=false
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__POOL_TIMEOUT=30
DATABASE__POOL_RECYCLE=1800


# ==========================================
# Redis
# ==========================================
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=
REDIS__DB=0
REDIS__SSL=false


# ==========================================
# Security
# ==========================================
SECURITY__ALLOWED_HOSTS=["*"]
SECURITY__CORS_ORIGINS=["*"]


# ==========================================
# JWT
# ==========================================
JWT__SECRET_KEY=
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT__REFRESH_TOKEN_EXPIRE_DAYS=7


# ==========================================
# LLM Providers
# ==========================================
LLM__PROVIDER=openai
LLM__MODEL=gpt-5
LLM__API_KEY=
LLM__BASE_URL=

LLM__TEMPERATURE=0.0
LLM__MAX_TOKENS=4096
LLM__TIMEOUT=60


# ==========================================
# Supported LLM Provider Keys
# ==========================================
OPENAI_API_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-pro

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=


# ==========================================
# Vector Database
# ==========================================
VECTOR_DB=chroma
CHROMA_PATH=./data/chroma


# ==========================================
# Telemetry
# ==========================================
OTEL_SERVICE_NAME=secgenie-ai
OTEL_EXPORTER_OTLP_ENDPOINT=


# ==========================================
# Logging
# ==========================================
LOGGING__LEVEL=INFO
LOGGING__FILE=logs/secgenie.log


# ==========================================
# API
# ==========================================
API__PREFIX=/api/v1
API__VERSION=v1
API__DOCS_ENABLED=true
API__REDOC_ENABLED=true
API__OPENAPI_ENABLED=true


# ==========================================
# Security Integrations
# ==========================================
TENABLE_API_KEY=
OPENVAS_URL=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=