# ==========================================
# Application
# ==========================================
APP_NAME=SecGenie AI
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# ==========================================
# Server
# ==========================================
HOST=127.0.0.1
PORT=8000

# ==========================================
# Database
# ==========================================
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ==========================================
# Redis
# ==========================================
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# JWT
# ==========================================
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# LLM Providers
# ==========================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-pro

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ==========================================
# Vector Database
# ==========================================
VECTOR_DB=chroma
CHROMA_PATH=./data/chroma

# ==========================================
# Telemetry
# ==========================================
OTEL_SERVICE_NAME=secgenie-ai
OTEL_EXPORTER_OTLP_ENDPOINT=

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=INFO

# ==========================================
# Integrations
# ==========================================
TENABLE_API_KEY=
OPENVAS_URL=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=