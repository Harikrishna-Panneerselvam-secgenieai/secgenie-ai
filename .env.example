# Application
APP__APP_NAME=SecGenie AI
APP__APP_VERSION=0.1.0
APP__ENVIRONMENT=development
APP__DEBUG=false


# Database
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__USERNAME=postgres
DATABASE__PASSWORD=
DATABASE__DATABASE=secgenie
DATABASE__ECHO=false


# Redis
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=
REDIS__DB=0
REDIS__SSL=false


# Security
SECURITY__ALLOWED_HOSTS=["*"]
SECURITY__CORS_ORIGINS=["*"]


# JWT
JWT__SECRET_KEY=
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT__REFRESH_TOKEN_EXPIRE_DAYS=7


# Logging
LOGGING__LEVEL=INFO
LOGGING__FILE=logs/secgenie.log


# LLM
LLM__PROVIDER=openai
LLM__MODEL=gpt-5.5
LLM__API_KEY=
LLM__BASE_URL=
LLM__TEMPERATURE=0
LLM__MAX_TOKENS=4096


# API
API__PREFIX=/api/v1
API__VERSION=v1
API__DOCS_ENABLED=true